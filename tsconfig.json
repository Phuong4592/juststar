{
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": {
      "@enosta/en-ui": ["./src/index.ts"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["vitest/globals"]
  },
  "include": ["src", ".storybook", "docs/site", "vitest.setup.ts"],
  "exclude": [
    "src/components/application-header/application-header.stories.tsx",
    "src/components/application-shell/application-shell.stories.tsx",
    "src/components/page-container/page-container.stories.tsx",
    "src/components/page-header/page-header.stories.tsx",
    "src/components/page-section/page-section.stories.tsx",
    "src/components/sidebar-navigation/sidebar-navigation.stories.tsx",
    "src/components/split-layout/split-layout.stories.tsx",
    "src/patterns/**/*.stories.tsx"
  ]
}
