{
  "name": "@enosta/en-ui",
  "version": "1.3.3",
  "description": "Enosta React primitives with colocated stories, documentation, and AI-readable contracts.",
  "homepage": "https://enosta.github.io/en-ui/",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Enosta/en-ui.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=18.17"
  },
  "files": [
    "dist",
    "contracts",
    ".agents/skills/en-ui-consumer",
    ".agents/skills/en-ui-visual-audit",
    "scripts/en-ui-audit.mjs",
    "scripts/en-ui-audit-options.mjs",
    "scripts/en-ui-check.mjs",
    "scripts/en-ui-context.mjs",
    "scripts/en-ui-init-ai.mjs",
    "src/components/**/*.contract.json",
    "src/components/**/README.md",
    "!src/components/application-header/**",
    "!src/components/application-shell/**",
    "!src/components/page-container/**",
    "!src/components/page-header/**",
    "!src/components/page-section/**",
    "!src/components/sidebar-navigation/**",
    "!src/components/split-layout/**",
    "src/style/themes/default.css",
    "src/style/tailwind-theme.css",
    "docs/foundations.md",
    "AGENTS.md",
    "COMPONENTS.md",
    "DESIGN.md",
    "llms.txt",
    "README.md"
  ],
  "bin": {
    "en-ui-audit": "./scripts/en-ui-audit.mjs",
    "en-ui-check": "./scripts/en-ui-check.mjs",
    "en-ui-context": "./scripts/en-ui-context.mjs",
    "en-ui-init-ai": "./scripts/en-ui-init-ai.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./themes/default.css": "./src/style/themes/default.css",
    "./tailwind.css": "./src/style/tailwind-theme.css",
    "./contract.json": "./contracts/design-system.contract.json",
    "./component-index.md": "./contracts/component-index.md",
    "./theme.json": "./contracts/theme.contract.json",
    "./foundations.md": "./docs/foundations.md",
    "./contracts/*": "./src/components/*/*.contract.json",
    "./docs/*": "./src/components/*/README.md",
    "./*.css": "./dist/styles.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "pnpm contract:generate && tsup src/index.ts --format esm --dts --external react --external react-dom --clean && pnpm styles:build",
    "check": "pnpm contract:check && pnpm generated:check && pnpm story:check && pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm design:check && pnpm build && pnpm build-storybook && pnpm site:build && pnpm pages:assemble && pnpm package:archive-check",
    "changeset": "changeset",
    "component:check": "node scripts/verify-component.mjs",
    "component:new": "node scripts/component-new.mjs",
    "contract:build": "pnpm contract:generate",
    "contract:check": "node scripts/verify-contracts.mjs",
    "contract:generate": "node scripts/build-contract.mjs",
    "contract:validate": "node scripts/validate-contracts.mjs",
    "dev": "pnpm story:source:generate && storybook dev -p 6006",
    "design:check": "pnpm design:tokens && pnpm design:layout",
    "design:layout": "playwright test --grep-invert @visual",
    "design:tokens": "node scripts/audit-visual-tokens.mjs",
    "design:update": "pnpm visual:update",
    "consumer:check": "node scripts/en-ui-check.mjs",
    "consumer:context": "node scripts/en-ui-context.mjs",
    "consumer:audit": "node scripts/en-ui-audit.mjs",
    "consumer:init-ai": "node scripts/en-ui-init-ai.mjs",
    "build-storybook": "pnpm story:source:generate && storybook build",
    "build-pages": "pnpm build-storybook && pnpm site:build && pnpm pages:assemble",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "generated:check": "node scripts/build-contract.mjs --check",
    "package:archive-check": "node scripts/verify-package.mjs",
    "package:check": "pnpm package:archive-check",
    "pages:assemble": "node scripts/build-pages.mjs",
    "prepack": "pnpm build",
    "release": "changeset publish",
    "site:build": "node scripts/build-site.mjs",
    "test": "vitest run",
    "styles:build": "tailwindcss -i ./src/style/index.css -o ./dist/styles.css --minify && node scripts/copy-font-assets.mjs",
    "story:check": "node scripts/verify-story-source.mjs",
    "story:source:generate": "node scripts/verify-story-source.mjs --write",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "visual:check": "playwright test --grep @visual",
    "visual:update": "playwright test --grep @visual --update-snapshots",
    "version-packages": "changeset version"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@daypicker/react": "^10.0.1",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@iconify/react": "^6.0.2",
    "tailwind-variants": "^3.2.1"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/cli": "^4.1.0",
    "@tailwindcss/language-server": "^0.16.0",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.3.4",
    "ajv": "^8.17.1",
    "axe-core": "^4.13.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "10.6.0",
    "globals": "^17.11.0",
    "jsdom": "^24.1.3",
    "prettier": "^3.9.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^5.4.19",
    "vitest": "^2.1.9"
  }
}
