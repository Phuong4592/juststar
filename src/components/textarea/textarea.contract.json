{
  "id": "component.textarea",
  "family": "en-ui",
  "status": "experimental",
  "maturity": { "previousStatus": "planned", "since": "1.3.1" },
  "documentation": "src/components/textarea/README.md",
  "exports": ["textareaVariants", "Textarea", "TextareaProps"],
  "publicParts": ["root"],
  "behaviorOwner": {
    "kind": "native",
    "owner": "@enosta/en-ui",
    "capabilities": ["native-semantics", "keyboard-interaction"]
  },
  "anatomy": {
    "structure": "<Textarea />",
    "parts": [
      {
        "part": "root",
        "description": "Root element or behavior owner for the component."
      }
    ]
  },
  "slots": [
    {
      "name": "children",
      "required": false,
      "description": "Component content where supported."
    }
  ],
  "props": [
    {
      "name": "size",
      "kind": "enum",
      "description": "Control min-height, padding, and text size.",
      "values": ["sm", "md", "lg"],
      "default": "md"
    },
    {
      "name": "unstyled",
      "kind": "boolean",
      "description": "Removes surface styling while keeping the native textarea element.",
      "default": false
    }
  ],
  "states": ["default", "disabled", "readonly", "invalid"],
  "requiredStories": [
    "Overview",
    "Basic",
    "Sizes",
    "Rows",
    "WithLabel",
    "Disabled",
    "Invalid",
    "Unstyled"
  ],
  "requiredTests": ["renders", "class-name"],
  "tokens": {
    "required": [
      "color.brand.400",
      "color.brand.500",
      "color.error.400",
      "color.error.500",
      "color.neutral.200",
      "color.neutral.400",
      "color.neutral.50",
      "color.neutral.900",
      "color.surface",
      "height.control.lg",
      "height.control.md",
      "height.control.sm",
      "radius.control",
      "shadow.surface",
      "space.2xs",
      "space.md",
      "space.sm"
    ]
  },
  "rules": ["component.textarea.preserve-semantics"],
  "migration": {
    "introducedIn": "1.3.1",
    "classification": "compatible",
    "notes": "Introduces Textarea."
  }
}
