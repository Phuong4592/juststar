{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enosta.dev/schemas/en-ui-component-contract.json",
  "title": "En UI component contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "family",
    "status",
    "maturity",
    "documentation",
    "exports",
    "publicParts",
    "behaviorOwner",
    "anatomy",
    "slots",
    "states",
    "requiredStories",
    "requiredTests",
    "tokens",
    "rules",
    "migration"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^component\\.[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "family": { "type": "string", "minLength": 1 },
    "status": { "enum": ["experimental", "beta", "stable", "deprecated"] },
    "maturity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["previousStatus", "since"],
      "properties": {
        "previousStatus": { "type": "string", "minLength": 1 },
        "since": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" }
      }
    },
    "documentation": { "type": "string", "pattern": "^src/(components|patterns)/.+/README\\.md$" },
    "exports": { "$ref": "#/$defs/stringList" },
    "publicParts": { "$ref": "#/$defs/stringList" },
    "behaviorOwner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "owner", "capabilities"],
      "properties": {
        "kind": { "enum": ["native", "package-managed", "protected-adapter"] },
        "owner": { "const": "@enosta/en-ui" },
        "capabilities": { "$ref": "#/$defs/stringList" }
      }
    },
    "anatomy": { "$ref": "#/$defs/anatomy" },
    "slots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "required", "description"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "props": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "description"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*$" },
          "kind": { "enum": ["enum", "boolean", "string", "number", "node"] },
          "description": { "type": "string", "minLength": 1 },
          "values": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "default": {
            "anyOf": [{ "type": "string" }, { "type": "boolean" }, { "type": "number" }]
          }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "const": "enum" } }, "required": ["kind"] },
            "then": { "required": ["values"], "properties": { "values": true } }
          }
        ]
      }
    },
    "states": { "$ref": "#/$defs/stringList" },
    "requiredStories": { "$ref": "#/$defs/stringList" },
    "requiredTests": { "$ref": "#/$defs/stringList" },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required"],
      "properties": { "required": { "$ref": "#/$defs/maybeEmptyStringList" } }
    },
    "componentVariables": {
      "type": "object",
      "additionalProperties": false,
      "required": ["customizable", "protected"],
      "properties": {
        "customizable": { "$ref": "#/$defs/cssVariableList" },
        "protected": { "$ref": "#/$defs/cssVariableList" }
      }
    },
    "rules": { "$ref": "#/$defs/stringList" },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["introducedIn", "classification", "notes"],
      "properties": {
        "introducedIn": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "classification": { "enum": ["compatible", "breaking"] },
        "notes": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "maybeEmptyStringList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "cssVariableList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^--[a-z][a-z0-9-]*$" }
    },
    "namedDescription": {
      "type": "object",
      "additionalProperties": false,
      "required": ["part", "description"],
      "properties": {
        "part": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "anatomy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["structure"],
      "properties": {
        "structure": {
          "type": "string",
          "minLength": 1,
          "description": "JSX-like composition showing the rendered structure."
        },
        "parts": { "type": "array", "items": { "$ref": "#/$defs/namedDescription" } }
      }
    }
  }
}
