{
  "schemaVersion": 2,
  "standard": "WCAG 2.2",
  "requiredConformance": "AA",
  "advisoryConformance": "AAA",
  "targetSizes": {
    "requiredAA": 24,
    "advisoryAAA": 44
  },
  "fontFamilies": {
    "primary": {
      "token": "--font-family-sans",
      "family": "Nunito Variable",
      "usage": "All interface copy, headings, labels, and prose."
    },
    "technical": {
      "token": "--font-family-mono",
      "family": "Geist Mono Variable",
      "usage": "Code, commands, file paths, hashes, serialized values, and other machine-oriented text only."
    }
  },
  "typographyRoles": {
    "caption": {
      "fontSize": { "token": "--font-size-caption", "expected": "12px" },
      "lineHeight": { "token": "--line-height-caption", "expected": "16px" },
      "fontWeight": { "token": "--font-weight-regular", "expected": "400" }
    },
    "body-small": {
