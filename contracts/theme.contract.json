    {
      "id": "on-error-error-700",
      "foreground": "--color-on-error",
      "background": "--color-error-700",
      "usage": "normal-text",
      "note": "Button danger hover."
    },
    {
      "id": "on-error-error-800",
      "foreground": "--color-on-error",
      "background": "--color-error-800",
      "usage": "normal-text",
      "note": "Button danger active."
    },
    {
      "id": "error-700-error-100",
      "foreground": "--color-error-700",
      "background": "--color-error-100",
      "usage": "normal-text",
      "note": "Button danger-soft."
    },
    {
      "id": "error-700-error-200",
      "foreground": "--color-error-700",
      "background": "--color-error-200",
      "usage": "normal-text",
      "note": "Button danger-soft hover."
    },
    {
      "id": "error-700-error-300",
      "foreground": "--color-error-700",
      "background": "--color-error-300",
      "usage": "normal-text",
      "note": "Button danger-soft active sits below AA until the error ramp is tuned.",
      "blocking": false
    },
    {
      "id": "on-accent-accent",
      "foreground": "--color-on-accent",
      "background": "--color-bg-accent",
      "usage": "normal-text"
    },
    {
      "id": "on-warning-warning",
      "foreground": "--color-on-warning",
      "background": "--color-bg-warning",
      "usage": "normal-text"
    },
    {
      "id": "on-success-success",
      "foreground": "--color-on-success",
      "background": "--color-bg-success",
      "usage": "normal-text"
    },
    {
      "id": "on-info-info",
      "foreground": "--color-on-info",
      "background": "--color-bg-info",
      "usage": "normal-text"
    },
    {
      "id": "focus-ring-surface",
      "foreground": "--focus-ring-color",
      "background": "--color-surface",
      "usage": "non-text",
      "note": "Focus ring sits below the 3:1 non-text minimum until the ring color is tuned.",
      "blocking": false
    }
